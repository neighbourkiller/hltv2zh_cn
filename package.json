{
  "name": "hltv-zh-cn",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "description": "保留网站结构与数据的 HLTV 简体中文界面脚本",
  "scripts": {
    "typecheck": "tsc --noEmit",
