# 依赖与工具缓存
node_modules/
.cache/
.vite/
*.tsbuildinfo

# 日常构建输出；artifacts/releases/ 中的冻结回退版本保留
/dist/

# 自动化测试的临时结果
/test-results/
/playwright-report/
/blob-report/
/coverage/

# 默认性能采样输出；docs/performance/ 中的版本化基线保留
/docs/performance/latest.json

# 运行日志；文档引用的验收日志保留
*.log
!/artifacts/qa/*.log

# 本地环境配置；配置模板保留
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 系统与编辑器临时文件
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
